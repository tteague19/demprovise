# Docker ignore file to optimize build context and security

# Version control
.git/
.gitignore
.github/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments (we use uv managed ones)
venv/
env/
ENV/
env.bak/
venv.bak/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Testing and coverage
.tox/
.nox/
.coverage
.pytest_cache/
.hypothesis/
htmlcov/
.coverage.*

# Large directories that slow down build
htmlcov/

# Documentation build
docs/_build/
.sphinx/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Environment variables (security)
.env
.env.local
.env.*.local

# Log files
*.log
logs/

# Temporary files
tmp/
temp/
.tmp/

# MacOS files
.DS_Store
.AppleDouble
.LSOverride

# Windows files
Thumbs.db
ehthumbs.db
Desktop.ini

# Development and build artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker files (avoid recursive inclusion)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD files
.travis.yml
.circleci/
.gitlab-ci.yml
azure-pipelines.yml

# Local development helpers
scripts/
dev_tools/
.local/

# Large test data files (keep small examples)
test_data/
*.parquet
*.h5
*.hdf5

# Backup files
*.bak
*.backup
*~

# OS generated files
.fuse_hidden*
.directory
.Trash-*
.nfs*

# Keep these important files:
# !docs/examples/
# !README.md
# !requirements.txt
# !pyproject.toml
# !uv.lock