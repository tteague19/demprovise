# Development Dockerfile with hot reload support
FROM python:3.11-slim as development

# Install uv and development tools
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Install system dependencies for development
RUN apt-get update && apt-get install -y \
    curl \
    git \
    vim \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables optimized for development
ENV UV_COMPILE_BYTECODE=0
ENV UV_LINK_MODE=copy
ENV PYTHONPATH=/app/src
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV STREAMLIT_SERVER_PORT=8501
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0
ENV STREAMLIT_SERVER_HEADLESS=true
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
ENV STREAMLIT_SERVER_FILE_WATCHER_TYPE=auto
ENV STREAMLIT_SERVER_RUN_ON_SAVE=true

# Create non-root user for development
RUN groupadd --gid 1001 devgroup && \
    useradd --uid 1001 --gid devgroup --shell /bin/bash --create-home devuser

# Create application directory and set permissions
WORKDIR /app
RUN chown -R devuser:devgroup /app

# Switch to non-root user
USER devuser

# Copy dependency files
COPY --chown=devuser:devgroup pyproject.toml uv.lock ./

# Install all dependencies including development tools
RUN uv sync --frozen --no-install-project

# Copy application code (this will be overridden by volume mount)
COPY --chown=devuser:devgroup . .

# Add virtual environment to path
ENV PATH="/app/.venv/bin:$PATH"

# Expose Streamlit port
EXPOSE 8501

# Development health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Run Streamlit with development settings
CMD ["streamlit", "run", "run_app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.runOnSave=true"]